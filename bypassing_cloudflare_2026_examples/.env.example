# ScrapeOps Proxy API key (https://scrapeops.io/app/register/main)
SCRAPEOPS_API_KEY=

# Which site to test (override per-run with --target / -t)
# Options: fbref | sportsdirect | hepsiburada | <full URL>
TARGET=fbref

# Optional: proxy URLs for step 3 (curl_cffi) and step 5 (Botasaurus)
# Format: http://username:password@proxy-host:port
# ScrapeOps residential:
#   http://scrapeops:YOUR_API_KEY@residential-proxy.scrapeops.io:8181
DATACENTER_PROXY=
RESIDENTIAL_PROXY=
